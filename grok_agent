@app.post("/plan")
def create_plan(
    data: PlanRequest
):

    inicio = time.perf_counter()


    try:

        # =============================================
        # CONFIGURACIÓN
        # =============================================

        config = {

            "configurable": {

                "thread_id":
                    data.thread_id
            }
        }


        # =============================================
        # EJECUTAR GRAFO
        # =============================================

        resultado = graph_app.invoke(

            {

                "messages": [

                    HumanMessage(
                        content=data.text
                    )
                ]
            },

            config=config
        )


        # =============================================
        # TIEMPO
        # =============================================

        tiempo = round(

            time.perf_counter()
            - inicio,

            3
        )


        # =============================================
        # PLAN
        # =============================================

        plan = resultado.get(

            "plan",

            {}
        )


        # =============================================
        # PARÁMETROS FALTANTES
        # =============================================

        parametros_faltantes = resultado.get(

            "parametros_faltantes",

            []
        )


        # =============================================
        # CONSULTA REESCRITA
        # =============================================

        consulta_reescrita = resultado.get(

            "search_query",

            ""
        )


        # =============================================
        # TOKENS
        # =============================================

        context_input_tokens = resultado.get(
            "context_input_tokens",
            0
        )

        context_output_tokens = resultado.get(
            "context_output_tokens",
            0
        )

        planner_input_tokens = resultado.get(
            "planner_input_tokens",
            0
        )

        planner_output_tokens = resultado.get(
            "planner_output_tokens",
            0
        )

        total_input_tokens = resultado.get(
            "input_tokens",
            0
        )

        total_output_tokens = resultado.get(
            "output_tokens",
            0
        )

        total_tokens = (
            total_input_tokens
            +
            total_output_tokens
        )


        # =============================================
        # RESPUESTA FINAL
        # =============================================

        respuesta = {

            "fecha_hora":

                datetime.now().strftime(
                    "%Y-%m-%d %H:%M:%S"
                ),

            "error":

                False,

            "tiempo":

                tiempo,

            "consulta_original":

                data.text,

            "consulta_reescrita":

                consulta_reescrita,

            "plan":

                plan,

            "parametros_a_pedir":

                parametros_faltantes,

            # =========================================
            # TOKENS
            # =========================================

            "tokens":

                {

                    "context_resolver":

                        {

                            "input":
                                context_input_tokens,

                            "output":
                                context_output_tokens,

                            "total":
                                (
                                    context_input_tokens
                                    +
                                    context_output_tokens
                                )
                        },


                    "planner":

                        {

                            "input":
                                planner_input_tokens,

                            "output":
                                planner_output_tokens,

                            "total":
                                (
                                    planner_input_tokens
                                    +
                                    planner_output_tokens
                                )
                        },


                    "total":

                        {

                            "input":
                                total_input_tokens,

                            "output":
                                total_output_tokens,

                            "total":
                                total_tokens
                        }
                }
        }


        # =============================================
        # GUARDAR LOG
        # =============================================

        ruta_archivo = os.path.join(

            os.path.dirname(
                os.path.abspath(__file__)
            ),

            "respuestas.txt"
        )


        with open(

            ruta_archivo,

            "a",

            encoding="utf-8"

        ) as archivo:

            archivo.write(

                json.dumps(

                    respuesta,

                    ensure_ascii=False

                ) + "\n"
            )


        # =============================================
        # DEVOLVER
        # =============================================

        return respuesta


    except Exception as e:

        # =============================================
        # TIEMPO
        # =============================================

        tiempo = round(

            time.perf_counter()
            - inicio,

            3
        )


        # =============================================
        # RESPUESTA ERROR
        # =============================================

        respuesta_error = {

            "fecha_hora":

                datetime.now().strftime(
                    "%Y-%m-%d %H:%M:%S"
                ),

            "error":

                True,

            "tiempo":

                tiempo,

            "mensaje":

                str(e)
        }


        # =============================================
        # GUARDAR ERROR
        # =============================================

        ruta_archivo = os.path.join(

            os.path.dirname(
                os.path.abspath(__file__)
            ),

            "respuestas.txt"
        )


        with open(

            ruta_archivo,

            "a",

            encoding="utf-8"

        ) as archivo:

            archivo.write(

                json.dumps(

                    respuesta_error,

                    ensure_ascii=False

                ) + "\n"
            )


        # =============================================
        # DEVOLVER ERROR
        # =============================================

        return respuesta_error
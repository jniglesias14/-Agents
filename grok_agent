planner_chain = planner_prompt | llm


# =====================================================
# PLANNER
# =====================================================

def planner(state: State):

    response = planner_chain.invoke({

        "herramientas":
            json.dumps(
                HERRAMIENTAS,
                ensure_ascii=False
            ),

        "question":
            state["search_query"],

        "fecha_actual":
            datetime.now().strftime("%Y-%m-%d"),

        "resultado_tools":
            json.dumps(
                state.get(
                    "resultado_tools",
                    []
                ),
                ensure_ascii=False
            )
    })


    # =================================================
    # TOKENS
    # =================================================

    usage = getattr(
        response,
        "usage_metadata",
        {}
    ) or {}


    planner_input_tokens = usage.get(
        "input_tokens",
        0
    )


    planner_output_tokens = usage.get(
        "output_tokens",
        0
    )


    # =================================================
    # CONTENIDO
    # =================================================

    contenido = response.content.strip()


    # =================================================
    # LIMPIAR MARKDOWN
    # =================================================

    if "```json" in contenido:

        contenido = contenido.split(
            "```json",
            1
        )[1]

        contenido = contenido.split(
            "```",
            1
        )[0]

    elif "```" in contenido:

        contenido = contenido.split(
            "```",
            1
        )[1]

        contenido = contenido.split(
            "```",
            1
        )[0]


    contenido = contenido.strip()


    # =================================================
    # PARSEAR JSON
    # =================================================

    try:

        datos = json.loads(
            contenido
        )

    except json.JSONDecodeError as e:

        raise ValueError(

            "El planner no devolvió JSON válido.\n\n"

            f"Error: {e}\n\n"

            f"Respuesta del modelo:\n"
            f"{contenido}"
        )


    # =================================================
    # VALIDAR PLAN
    # =================================================

    try:

        plan = Plan.model_validate(datos)

    except Exception as e:

        raise ValueError(

            "El planner devolvió un plan inválido.\n\n"

            f"Error: {e}\n\n"

            "JSON recibido:\n"

            f"{json.dumps(datos, ensure_ascii=False, indent=2)}"
        )


    # =================================================
    # TOKENS TOTALES
    # =================================================

    context_input_tokens = state.get(
        "context_input_tokens",
        0
    )

    context_output_tokens = state.get(
        "context_output_tokens",
        0
    )


    total_input_tokens = (
        context_input_tokens
        +
        planner_input_tokens
    )


    total_output_tokens = (
        context_output_tokens
        +
        planner_output_tokens
    )


    # =================================================
    # DEVOLVER ESTADO
    # =================================================

    return {

        "plan":
            plan.model_dump(),

        "parametros_faltantes":
            plan.parametros_a_pedir,

        # Totales
        "input_tokens":
            total_input_tokens,

        "output_tokens":
            total_output_tokens,

        # Tokens individuales
        "context_input_tokens":
            context_input_tokens,

        "context_output_tokens":
            context_output_tokens,

        "planner_input_tokens":
            planner_input_tokens,

        "planner_output_tokens":
            planner_output_tokens
    }


# =====================================================
# GRAFO
# =====================================================

graph = StateGraph(
    State
)


# =====================================================
# NODOS
# =====================================================

graph.add_node(
    "context_resolver",
    context_resolver
)

graph.add_node(
    "planner",
    planner
)


# =====================================================
# FLUJO
# =====================================================

graph.add_edge(
    START,
    "context_resolver"
)

graph.add_edge(
    "context_resolver",
    "planner"
)


graph.add_edge(
    "planner",
    END
)


# =====================================================
# COMPILAR
# =====================================================

graph_app = graph.compile(
    checkpointer=memory
)



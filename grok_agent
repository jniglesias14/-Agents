# =====================================================
# GUARDAR RESPUESTA DEL PARÁMETRO
# =====================================================

def guardar_parametro(state: State): #guarda la respuesta del usuario

    esperando = state.get( #comprobamos si estamos esperando un parametro
        "esperando_parametro",
        False
    )

    parametro = state.get( #traemos el parametro actual
        "parametro_actual"
    )

    # -------------------------------------------------
    # Si no estamos esperando ningún parámetro,
    # no hacemos nada.
    # -------------------------------------------------

    if not esperando or not parametro:

        return {}


    messages = state.get( #obtenemos los mensajes (crea un pedido, que forma de pago,transferencia)
        "messages",
        []
    )

    if not messages:

        return {}


    # -------------------------------------------------
    # RESPUESTA DEL USUARIO
    # -------------------------------------------------

    respuesta = messages[-1].content.strip() #obtenemos la respuesta


    # -------------------------------------------------
    # COPIAR PARÁMETROS RECOPILADOS
    # -------------------------------------------------

    parametros_recopilados = dict( #coge los parametros anteriores recopilados
        state.get(
            "parametros_recopilados",
            {}
        )
    )


    # -------------------------------------------------
    # GUARDAR
    # -------------------------------------------------

    parametros_recopilados[parametro] = respuesta #añade el nuevo parametro con el resultado


    # -------------------------------------------------
    # QUITAR PARÁMETRO DE PENDIENTES
    # -------------------------------------------------

    parametros_faltantes = list(
        state.get(
            "parametros_faltantes",
            []
        )
    )

    if parametro in parametros_faltantes:

        parametros_faltantes.remove(
            parametro
        )


    # -------------------------------------------------
    # SIGUIENTE PARAMETRO
    # -------------------------------------------------

    siguiente_parametro = (
        parametros_faltantes[0]
        if parametros_faltantes
        else None
    )


    return { #Devuelve cambios al estado

        "parametros_recopilados":
            parametros_recopilados,

        "parametros_faltantes":
            parametros_faltantes,

        "parametro_actual":
            siguiente_parametro,

        "esperando_parametro":
            siguiente_parametro is not None
    }


# =====================================================
# PLANNER
# =====================================================

def planner(state: State):

    parametros_recopilados = state.get(
        "parametros_recopilados",
        {}
    )

    response = planner_chain.invoke({

        "herramientas":
            json.dumps(
                HERRAMIENTAS,
                ensure_ascii=False
            ),

        "question":
            state.get(
                "search_query",
                ""
            ),

        "fecha_actual":
            datetime.now().strftime(
                "%Y-%m-%d"
            ),

        "resultado_tools":
            json.dumps(
                state.get(
                    "resultado_tools",
                    []
                ),
                ensure_ascii=False
            ),

        "parametros_recopilados":
            json.dumps(
                parametros_recopilados,
                ensure_ascii=False
            ),

        "parametro_actual":
            state.get(
                "parametro_actual"
            )
    })


    # =================================================
    # TOKENS
    # =================================================

    usage = getattr(
        response,
        "usage_metadata",
        {}
    ) or {}


    planner_input_tokens = usage.get(
        "input_tokens",
        0
    )

    planner_output_tokens = usage.get(
        "output_tokens",
        0
    )


    # =================================================
    # CONTENIDO
    # =================================================

    contenido = response.content.strip()


    # =================================================
    # LIMPIAR MARKDOWN
    # =================================================

    if "```json" in contenido:

        contenido = contenido.split(
            "```json",
            1
        )[1]

        contenido = contenido.split(
            "```",
            1
        )[0]

    elif "```" in contenido:

        contenido = contenido.split(
            "```",
            1
        )[1]

        contenido = contenido.split(
            "```",
            1
        )[0]


    contenido = contenido.strip()


    # =================================================
    # PARSEAR JSON
    # =================================================

    try:

        datos = json.loads(
            contenido
        )

    except json.JSONDecodeError as e:

        raise ValueError(

            "El planner no devolvió JSON válido.\n\n"

            f"Error: {e}\n\n"

            f"Respuesta del modelo:\n{contenido}"
        )


    # =================================================
    # VALIDAR PLAN
    # =================================================

    try:

        plan = Plan.model_validate(
            datos
        )

    except Exception as e:

        raise ValueError(

            "El planner devolvió un plan inválido.\n\n"

            f"Error: {e}\n\n"

            f"JSON recibido:\n"
            f"{json.dumps(datos, ensure_ascii=False, indent=2)}"
        )


    # =================================================
    # PENDIENTES
    # =================================================

    parametros_faltantes = (
        plan.parametros_a_pedir
    )


    # =================================================
    # PRÓXIMO PARÁMETRO
    # =================================================

    if parametros_faltantes:

        parametro_actual = (
            parametros_faltantes[0]
        )

        esperando_parametro = True

    else:

        parametro_actual = None

        esperando_parametro = False


    # =================================================
    # TOKENS
    # =================================================

    context_input_tokens = state.get(
        "context_input_tokens",
        0
    )

    context_output_tokens = state.get(
        "context_output_tokens",
        0
    )


    total_input_tokens = (
        context_input_tokens
        +
        planner_input_tokens
    )

    total_output_tokens = (
        context_output_tokens
        +
        planner_output_tokens
    )


    # =================================================
    # DEVOLVER ESTADO
    # =================================================

    return {

        "plan":
            plan.model_dump(),

        "parametros_faltantes":
            parametros_faltantes,

        "parametro_actual":
            parametro_actual,

        "esperando_parametro":
            esperando_parametro,

        "respuesta_parametro":
            plan.respuesta_usuario,

        "planner_input_tokens":
            planner_input_tokens,

        "planner_output_tokens":
            planner_output_tokens,

        "input_tokens":
            total_input_tokens,

        "output_tokens":
            total_output_tokens
    }


# =====================================================
# DECISIÓN INICIAL
# =====================================================

def decidir_inicio(state: State): #decide si context_resolver o guardar_parametro

    if state.get(
        "esperando_parametro",
        False
    ):

        return "guardar_parametro"

    return "context_resolver"

# =====================================================
# FINALIZAR OPERACION
# =====================================================
def decidir_despues_planner(state: State):

    if state.get("esperando_parametro", True):
        return "fin"

    return "finalizar_operacion"

def finalizar_operacion(state):

    return {
        "parametros_faltantes": [],
        "parametros_recopilados": {},
        "parametro_actual": None,
        "esperando_parametro": False,
        "respuesta_parametro": None
    }



# =====================================================
# GRAFO
# =====================================================

graph = StateGraph( #Creamos el grafo
    State
)


# =====================================================
# NODOS
# =====================================================

graph.add_node(
    "guardar_parametro",
    guardar_parametro
)

graph.add_node(
    "context_resolver",
    context_resolver
)

graph.add_node(
    "planner",
    planner
)

graph.add_node(
    "finalizar_operacion",
    finalizar_operacion
)


# =====================================================
# INICIO CONDICIONAL
# =====================================================
#ejecuta decidir_inicio() para decidir qué nodo ejecutar si guardar_parametro o context_resolver
graph.add_conditional_edges(

    START,

    decidir_inicio,

    {

        "guardar_parametro":
            "guardar_parametro",

        "context_resolver":
            "context_resolver"
    }
)


# =====================================================
# GUARDAR → CONTEXTO
# =====================================================

graph.add_edge(
    "guardar_parametro",
    "context_resolver"
)


# =====================================================
# CONTEXTO → PLANNER
# =====================================================

graph.add_edge(
    "context_resolver",
    "planner"
)


# =====================================================
# PLANNER → FIN
# =====================================================

graph.add_conditional_edges(
    "planner",

    decidir_despues_planner,

    {
        "finalizar_operacion": "finalizar_operacion",
        "fin": END
    }
)




# =====================================================
# COMPILAR
# =====================================================

graph_app = graph.compile(
    checkpointer=memory
)


# =====================================================
# REQUEST / PLAN
# =====================================================

class PlanRequest(BaseModel):

    text: str

    thread_id: str


# =====================================================
# REQUEST / MEMORY
# =====================================================

class MemoryRequest(BaseModel):

    thread_id: str

    resultado_tools: Any


# =====================================================
# ENDPOINT /memory
# =====================================================

@app.post("/memory")
def guardar_resultado_memoria(
    data: MemoryRequest
):

    try:

        config = {

            "configurable": {

                "thread_id":
                    data.thread_id
            }
        }


        graph_app.update_state(

            config,

            {

                "resultado_tools":
                    data.resultado_tools
            }
        )


        estado = graph_app.get_state(
            config
        )


        return {

            "ok":
                True,

            "thread_id":
                data.thread_id,

            "resultado_tools":
                estado.values.get(
                    "resultado_tools",
                    []
                )
        }


    except Exception as e:

        return {

            "ok":
                False,

            "thread_id":
                data.thread_id,

            "error":
                str(e)
        }


# =====================================================
# ENDPOINT /plan
# =====================================================

@app.post("/plan")
def create_plan(
    data: PlanRequest
):

    inicio = time.perf_counter()


    try:

        # =================================================
        # CONFIGURACIÓN THREAD
        # =================================================

        config = {

            "configurable": {

                "thread_id":
                    data.thread_id
            }
        }


        # =================================================
        # EJECUTAR GRAFO
        # =================================================

        resultado = graph_app.invoke(

            {

                "messages": [

                    HumanMessage(
                        content=data.text
                    )
                ]

            },

            config=config
        )


        # =================================================
        # TIEMPO
        # =================================================

        tiempo = round(

            time.perf_counter()
            - inicio,

            3
        )


        # =================================================
        # DATOS
        # =================================================

        plan = resultado.get(
            "plan",
            {}
        )


        parametros_faltantes = resultado.get(
            "parametros_faltantes",
            []
        )


        consulta_reescrita = resultado.get(
            "search_query",
            ""
        )


        respuesta_parametro = resultado.get(
            "respuesta_parametro"
        )


        parametros_recopilados = resultado.get(
            "parametros_recopilados",
            {}
        )


        esperando_parametro = resultado.get(
            "esperando_parametro",
            False
        )


        parametro_actual = resultado.get(
            "parametro_actual"
        )


        # =================================================
        # TOKENS
        # =================================================

        context_input_tokens = resultado.get(
            "context_input_tokens",
            0
        )

        context_output_tokens = resultado.get(
            "context_output_tokens",
            0
        )

        planner_input_tokens = resultado.get(
            "planner_input_tokens",
            0
        )

        planner_output_tokens = resultado.get(
            "planner_output_tokens",
            0
        )

        total_input_tokens = resultado.get(
            "input_tokens",
            0
        )

        total_output_tokens = resultado.get(
            "output_tokens",
            0
        )

        total_tokens = (
            total_input_tokens
            +
            total_output_tokens
        )


        # =================================================
        # RESPUESTA
        # =================================================

        respuesta = {

            "fecha_hora":
                datetime.now().strftime(
                    "%Y-%m-%d %H:%M:%S"
                ),

            "error":
                False,

            "tiempo":
                tiempo,

            "consulta_original":
                data.text,

            "consulta_reescrita":
                consulta_reescrita,

            "plan":
                plan,

            "parametros_a_pedir":
                parametros_faltantes,

            "parametros_recopilados":
                parametros_recopilados,

            "parametro_actual":
                parametro_actual,

            "esperando_parametro":
                esperando_parametro,

            "respuesta_usuario":
                respuesta_parametro,

            "tokens":

                {

                    "context_resolver":

                        {

                            "input":
                                context_input_tokens,

                            "output":
                                context_output_tokens,

                            "total":
                                (
                                    context_input_tokens
                                    +
                                    context_output_tokens
                                )
                        },

                    "planner":

                        {

                            "input":
                                planner_input_tokens,

                            "output":
                                planner_output_tokens,

                            "total":
                                (
                                    planner_input_tokens
                                    +
                                    planner_output_tokens
                                )
                        },

                    "total":

                        {

                            "input":
                                total_input_tokens,

                            "output":
                                total_output_tokens,

                            "total":
                                total_tokens
                        }
                }
        }


        # =================================================
        # LOG
        # =================================================

        ruta_archivo = os.path.join(

            os.path.dirname(
                os.path.abspath(__file__)
            ),

            "respuestas.txt"
        )


        with open(

            ruta_archivo,

            "a",

            encoding="utf-8"

        ) as archivo:

            archivo.write(

                json.dumps(

                    respuesta,

                    ensure_ascii=False

                ) + "\n"
            )


        return respuesta


    except Exception as e:

        tiempo = round(

            time.perf_counter()
            - inicio,

            3
        )


        respuesta_error = {

            "fecha_hora":

                datetime.now().strftime(
                    "%Y-%m-%d %H:%M:%S"
                ),

            "error":
                True,

            "tiempo":
                tiempo,

            "mensaje":
                str(e)
        }


        ruta_archivo = os.path.join(

            os.path.dirname(
                os.path.abspath(__file__)
            ),

            "respuestas.txt"
        )


        with open(

            ruta_archivo,

            "a",

            encoding="utf-8"

        ) as archivo:

            archivo.write(

                json.dumps(

                    respuesta_error,

                    ensure_ascii=False

                ) + "\n"
            )


        return respuesta_error

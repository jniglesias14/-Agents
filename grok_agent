# =====================================================
# RESOLVER CONTEXTO
# =====================================================

def context_resolver(state: State):  #recibe el estado actual y resuelve el contexto reescribiendo la consulta

    messages = state.get("messages", [])

    if not messages:
        return {
            "search_query": ""
        }

    # =================================================
    # HISTORIAL
    # =================================================

    history = "\n".join(
        f"{'Usuario' if isinstance(msg, HumanMessage) else 'Asistente'}: {msg.content}"
        for msg in messages[:-1]
    )

    # =================================================
    # MENSAJE ACTUAL
    # =================================================

    question = messages[-1].content

    # =================================================
    # RESULTADOS ANTERIORES
    # =================================================

    resultado_tools = state.get(
        "resultado_tools",
        []
    )

    # =================================================
    # INVOCAR MODELO
    # =================================================

    response = context_resolver_chain.invoke({

        "history":
            history,

        "question":
            question,

        "resultado_tools":
            json.dumps(
                resultado_tools,
                ensure_ascii=False
            )
    })

    # =================================================
    # TOKENS
    # =================================================

    usage = getattr(
        response,
        "usage_metadata",
        {}
    ) or {}

    context_input_tokens = usage.get(
        "input_tokens",
        0
    )

    context_output_tokens = usage.get(
        "output_tokens",
        0
    )

    # =================================================
    # CONSULTA REESCRITA
    # =================================================

    consulta_reescrita = response.content.strip()

    # =================================================
    # DEVOLVER
    # =================================================

    return {

        "search_query":
            consulta_reescrita,

        "context_input_tokens":
            context_input_tokens,

        "context_output_tokens":
            context_output_tokens,

        "planner_input_tokens":
            0,

        "planner_output_tokens":
            0,

        "input_tokens":
            context_input_tokens,

        "output_tokens":
            context_output_tokens
    }



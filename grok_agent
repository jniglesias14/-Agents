# =====================================================
# ENDPOINT /memory
# =====================================================

@app.post("/memory")
def guardar_resultado_memoria(
    data: MemoryRequest
):

    try:

        # =============================================
        # CONFIGURACIÓN DEL THREAD
        # =============================================

        config = {

            "configurable": {

                "thread_id":
                    data.thread_id
            }
        }


        # =============================================
        # GUARDAR RESULTADO
        # =============================================

        graph_app.update_state(

            config,

            {

                "resultado_tools":
                    data.resultado_tools
            }
        )


        # =============================================
        # COMPROBAR QUE SE HA GUARDADO
        # =============================================

        estado = graph_app.get_state(
            config
        )


        return {

            "ok":
                True,

            "thread_id":
                data.thread_id,

            "resultado_tools":
                estado.values.get(
                    "resultado_tools",
                    []
                )
        }


    except Exception as e:

        return {

            "ok":
                False,

            "thread_id":
                data.thread_id,

            "error":
                str(e)
        }


